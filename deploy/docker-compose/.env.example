# 复制为 .env 后使用：cp .env.example .env
# docker compose 会自动读取同目录的 .env，.env 已被 .gitignore 忽略。
MYSQL_ROOT_PASSWORD=please-change-root-password
MYSQL_DATABASE=qmPlus
MYSQL_USER=gva
MYSQL_PASSWORD=please-change-app-password

# 首次启动时服务端还没有数据库配置，需要在 Web 初始化页填写：
#   数据库类型 mysql / 主机 mysql / 端口 3306
#   库名、用户、密码与上面三项保持一致
# 初始化写回 server/config.docker.yaml 后，把该文件的 init-db-enable 改为 false 并重启。
