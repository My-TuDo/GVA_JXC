[Unit]
Description=JXC demo server
After=network-online.target mysqld.service
Wants=network-online.target

[Service]
Type=simple
User=jxc
Group=jxc
WorkingDirectory=/opt/jxc/server
Environment=GIN_MODE=release
Environment=TZ=Asia/Shanghai
ExecStart=/opt/jxc/server/jxc-server -c /opt/jxc/server/config.yaml
Restart=always
RestartSec=5
LimitNOFILE=65535

# 加固：全局只读，仅放行日志/上传/备份目录
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/jxc/server/log /opt/jxc/server/uploads /opt/jxc/server/config.yaml /opt/jxc/backups

[Install]
WantedBy=multi-user.target
